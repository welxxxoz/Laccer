<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Laccer — Esports</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;600;700&family=UnifrakturMaguntia&display=swap" rel="stylesheet">
<style>
:root{--bg:#0a0a0a;--fg:#f2f2f2;--mute:#8c8c8c;--line:#222;--accent:#e4002b;--gold:#d4af37}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;scroll-padding-top:90px}
body{background:var(--bg);color:var(--fg);font-family:Barlow,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;font-size:17px;line-height:1.6;}
a{color:inherit}
button{font:inherit;cursor:pointer}
.wrap{width:min(1100px,calc(100% - 48px));margin-inline:auto}

/* HEADER */
.top{position:fixed;inset:0 0 auto;z-index:20;height:72px;background:rgba(10,10,10,.85);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.bar{height:100%;display:flex;align-items:center;justify-content:space-between}
.brand{display:flex;align-items:center;gap:12px;text-decoration:none;font-weight:700;font-size:1.1rem;letter-spacing:.2em}
.logo-sm{display:block;width:40px;height:40px;flex:none}
.nav{display:flex;gap:32px;align-items: center;}
.nav a{color:var(--mute);text-decoration:none;font-size:1rem;}
.nav a:hover{color:var(--fg)}
.btn-register{padding: 8px 16px; background: transparent; border: 1px solid #444; color: #fff; border-radius: 4px; font-weight: 600; transition: 0.2s;}
.btn-register:hover{background: #fff; color: #000; border-color: #fff;}
.burger{display:none;background:none;border:1px solid var(--line);border-radius:8px;height:44px;padding:0 16px;color:var(--fg);cursor:pointer}

/* HERO */
.hero{width:min(1100px,calc(100% - 48px));margin-inline:auto;min-height:100vh;display:grid;grid-template-columns:1.2fr 1fr;align-items:center;gap:40px;padding:120px 0 80px}
.hero h1{font-family:"UnifrakturMaguntia","Old English Text MT",serif;font-weight:400;font-size:clamp(5rem,14vw,11rem);line-height:.9;margin-bottom:12px}
.tag{font-size:1.35rem;font-weight:600;margin-bottom:10px}
.hero p{color:var(--mute);max-width:520px}
.links{display:flex;flex-wrap:wrap;align-items:center;gap:24px;margin-top:36px}
.link-btn{color:var(--fg);text-decoration:none;border-bottom:1px solid var(--fg);padding-bottom:4px}
.outline{padding:12px 22px;border:1px solid var(--line);border-radius:999px;color:var(--fg);text-decoration:none;transition:border-color .2s}
.outline:hover{border-color:var(--fg)}
.hero-logo{width:min(420px,80vw);aspect-ratio:1/1;justify-self:end;}

/* SECTIONS */
.band{padding:96px 0;border-top:1px solid var(--line)}
h2{font-size:clamp(2rem,4vw,2.8rem);font-weight:700;letter-spacing:-.01em;margin-bottom:32px}
.tabs{display:flex;flex-wrap:wrap;gap:28px;border-bottom:1px solid var(--line)}
.tab{position:relative;background:none;border:0;padding:0 0 14px;color:var(--mute);font-size:1.05rem;font-weight:600;cursor:pointer;}
.tab:hover{color:var(--fg)}
.tab.active{color:var(--fg)}
.tab.active::after{content:"";position:absolute;left:0;right:0;bottom:-1px;height:2px;background:var(--fg)}
.group{margin-top:44px}
.group h3{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:baseline;gap:8px 16px;font-size:1.1rem;font-weight:600}
.group h3 span{font-size:.95rem;font-weight:400;color:var(--mute)}
.roster{list-style:none;border-top:1px solid var(--line);margin-top:10px}
.roster li{display:flex;align-items:center;gap:18px;padding:16px 4px;border-bottom:1px solid var(--line);}
.roster li:hover{background:rgba(255,255,255,.025)}
.nick{font-size:1.25rem;font-weight:700}
.roster .sub{margin-left:auto;font-size:.92rem;color:var(--mute)}
.roster .tba .nick{color:#4a4a4a}
.flag{display:flex;align-items:center;justify-content:center;flex:none;width:32px;height:21px;border-radius:3px;overflow:hidden;font-size:20px;line-height:1}
.soon{padding:20px 0;color:var(--mute);border-bottom:1px solid var(--line)}

/* СЕРВЕРА */
.servers-grid{display:grid;gap:40px;margin-top:20px}
.server-category h3{font-size:1.4rem;font-weight:700;margin-bottom:16px;color:var(--fg);border-bottom:1px solid var(--line);padding-bottom:10px}
.server-list{display:grid;grid-template-columns:repeat(auto-fill, minmax(280px,1fr));gap:16px}
.server-card{background:#111;border:1px solid var(--line);padding:20px;border-radius:8px;display:flex;flex-direction:column;gap:8px;}
.server-card h4{font-size:1.1rem;font-weight:600;color:var(--fg);margin-bottom:4px}
.server-card .meta{font-size:0.9rem;color:var(--mute);display:flex;flex-direction:column;gap:4px;margin-bottom:10px}
.server-card .meta strong{color:var(--fg);font-weight:600}
.server-card .ip-box{display:flex;align-items:center;gap:8px;background:#000;padding:10px;border:1px solid #222;border-radius:4px;margin-top:auto;font-family:monospace;font-size:0.95rem}
.server-card .ip-box span{flex:1;color:#ccc;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.copy-btn{background:none;border:none;color:var(--fg);cursor:pointer;padding:4px;font-size:1.1rem;}
.book-btn{display:block;text-align:center;padding:10px 16px;background:#222;border:1px solid #444;color:var(--fg);text-decoration:none;border-radius:4px;font-size:0.95rem;margin-top:auto}
.book-btn:hover{background:#333;border-color:var(--fg)}

/* Кнопка Премиум */
.premium-btn-wrapper{text-align:center; margin-top: 40px;}
.premium-btn{background: linear-gradient(45deg, #d4af37, #f3e5ab); color: #0a0a0a; border: none; padding: 16px 32px; font-size: 1.1rem; font-weight: 700; border-radius: 4px; text-transform: uppercase; letter-spacing: 1px; cursor: pointer;}

/* МОДАЛЬНЫЕ ОКНА */
.modal { display: none; position: fixed; z-index: 100; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.8); align-items: center; justify-content: center; }
.modal-content { background: #111; padding: 30px; border: 1px solid #333; border-radius: 8px; width: 100%; max-width: 450px; position: relative; }
.close-btn { position: absolute; top: 15px; right: 20px; font-size: 28px; cursor: pointer; color: #888; line-height: 1; }
.close-btn:hover { color: #fff; }
.modal h2 { font-size: 1.8rem; margin-bottom: 10px; color: #fff; }
.modal p { color: #8c8c8c; margin-bottom: 20px; font-size: 0.95rem;}
#auth-form input { width: 100%; padding: 12px; margin-bottom: 15px; background: #000; border: 1px solid #333; color: #fff; border-radius: 4px; }
#auth-form button { width: 100%; padding: 12px; background: #f2f2f2; color: #0a0a0a; border: none; font-weight: bold; cursor: pointer; border-radius: 4px; }
#auth-form button:hover { background: #ccc; }
#auth-message { margin-top: 15px; font-size: 14px; text-align: center; }

.premium-features { list-style: none; margin: 20px 0; padding: 0; }
.premium-features li { padding: 10px 0; border-bottom: 1px solid #222; display: flex; align-items: center; gap: 10px; color: #ddd; font-size: 1rem;}
.premium-features li::before { content: '★'; color: var(--gold); }
.premium-buy-btn { display: block; width: 100%; padding: 15px; background: var(--gold); color: #000; text-align: center; font-weight: bold; text-decoration: none; border-radius: 4px; font-size: 1.1rem; text-transform: uppercase; box-sizing: border-box;}

@media (max-width:860px){
  .hero{grid-template-columns:1fr;min-height:auto;padding:120px 0 70px}
  .hero-logo{order:-1;justify-self:center;width:min(300px,70vw)}
}
@media (max-width:760px){
  .burger{display:block}
  .nav{display:none;position:absolute;top:72px;left:0;right:0;flex-direction:column;gap:0;background:var(--bg);border-bottom:1px solid var(--line); padding-bottom: 15px;}
  .nav.open{display:flex}
  .nav a{padding:16px 24px;border-top:1px solid var(--line);color:var(--fg); width: 100%;}
  .btn-register { margin: 10px 24px; width: calc(100% - 48px); }
}
</style>
<!-- Подключаем Supabase -->
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
</head>
<body>

<header class="top">
  <div class="bar wrap">
    <a class="brand" href="#top">LACCER</a>
    <button class="burger" id="burger">Меню</button>
    <nav class="nav" id="nav">
      <a href="#teams">Составы</a>
      <a href="#servers">Сервера</a>
      <a href="#merch">Мерч</a>
      <button class="btn-register" id="open-auth">Регистрация</button>
    </nav>
  </div>
</header>

<main>
  <section class="hero" id="top">
    <div>
      <h1>Laccer</h1>
      <p class="tag">Киберспортивная организация</p>
      <p>Составы по CS2, Dota 2, Brawl Stars и шахматам.</p>
    </div>
    <div class="hero-logo">
       <!-- Простая SVG заглушка вместо сложного логотипа, чтобы не ломалось -->
       <svg viewBox="0 0 200 200"><circle cx="100" cy="100" r="97" fill="none" stroke="#f2f2f2" stroke-opacity=".18"/><circle cx="100" cy="100" r="58" fill="#0a0a0a" stroke="#f2f2f2" stroke-width="2"/><text x="100" y="115" text-anchor="middle" font-family="serif" font-size="40" fill="#f2f2f2">L</text></svg>
    </div>
  </section>

  <section class="band" id="teams">
    <div class="wrap">
      <h2>Составы</h2>
      <div class="tabs">
        <button class="tab active" onclick="showTeam('cs2', this)">CS2</button>
        <button class="tab" onclick="showTeam('dota2', this)">Dota 2</button>
        <button class="tab" onclick="showTeam('brawl', this)">Brawl Stars</button>
        <button class="tab" onclick="showTeam('chess', this)">Шахматы</button>
      </div>
      <div id="roster"></div>
    </div>
  </section>

  <section class="band" id="servers">
    <div class="wrap">
      <h2>Игровые сервера</h2>
      
      <div class="servers-grid">
        <div class="server-category">
          <h3>Surf</h3>
          <div class="server-list">
            <div class="server-card">
              <h4>Surf #1</h4>
              <div class="meta"><div><strong>Карта:</strong> surf_boreas</div><div><strong>Локация:</strong> Россия</div></div>
              <div class="ip-box"><span>92.51.22.94:27005</span></div>
            </div>
          </div>
        </div>

        <div class="server-category">
          <h3>KZ (Kreedz)</h3>
          <div class="server-list">
            <div class="server-card">
              <h4>KZ #1</h4>
              <div class="meta"><div><strong>Карта:</strong> kz_leto_v2</div><div><strong>Локация:</strong> Россия</div></div>
              <div class="ip-box"><span>92.51.22.94:27006</span></div>
            </div>
            <div class="server-card">
              <h4>KZ #2</h4>
              <div class="meta"><div><strong>Карта:</strong> kz_leto_v2</div><div><strong>Локация:</strong> Таджикистан</div></div>
              <div class="ip-box"><span>79.170.191.123:27022</span></div>
            </div>
          </div>
        </div>

        <div class="server-category">
          <h3>Праки (Pracc)</h3>
          <div class="server-list">
            <div class="server-card">
              <h4>Pracc #1</h4>
              <div class="meta"><div><strong>Локация:</strong> Россия</div></div>
              <a href="https://t.me/z0rtez" target="_blank" class="book-btn">Забронировать</a>
            </div>
            <div class="server-card">
              <h4>Pracc #2</h4>
              <div class="meta"><div><strong>Локация:</strong> Финляндия</div></div>
              <a href="https://t.me/z0rtez" target="_blank" class="book-btn">Забронировать</a>
            </div>
            <div class="server-card">
              <h4>Pracc #3</h4>
              <div class="meta"><div><strong>Локация:</strong> Германия</div></div>
              <a href="https://t.me/z0rtez" target="_blank" class="book-btn">Забронировать</a>
            </div>
            <div class="server-card">
              <h4>Pracc #4</h4>
              <div class="meta"><div><strong>Локация:</strong> Казахстан</div></div>
              <a href="https://t.me/z0rtez" target="_blank" class="book-btn">Забронировать</a>
            </div>
          </div>
        </div>
      </div>

      <div class="premium-btn-wrapper">
        <button class="premium-btn" id="open-premium">Купить Премиум</button>
      </div>
    </div>
  </section>

  <!-- Оставил только секцию серверов, мерч и остальное можешь вернуть по аналогии -->
</main>

<!-- МОДАЛЬНОЕ ОКНО РЕГИСТРАЦИИ -->
<div id="auth-modal" class="modal">
  <div class="modal-content">
    <span class="close-btn" id="close-auth">&times;</span>
    <h2>Вход в Laccer</h2>
    <p>Создай аккаунт, чтобы бронировать праки и получать премиум.</p>
    <form id="auth-form">
      <input type="email" id="email" placeholder="Твой Email" required>
      <input type="password" id="password" placeholder="Пароль (мин. 6 символов)" required minlength="6">
      <button type="submit" id="submit-btn">Войти / Зарегистрироваться</button>
    </form>
    <p id="auth-message"></p>
  </div>
</div>

<!-- МОДАЛЬНОЕ ОКНО ПРЕМИУМА -->
<div id="premium-modal" class="modal">
  <div class="modal-content" style="max-width: 500px;">
    <span class="close-btn" id="close-premium">&times;</span>
    <h2 style="color: var(--gold);">Премиум подписка</h2>
    <ul class="premium-features">
      <li>Скинченджер</li>
      <li>Безлимитное бронирование</li>
      <li>Резервный слот</li>
      <li>Отсутствие рекламы</li>
      <li>Иммунитет к AWP</li>
      <li>Приоритет поддержки</li>
      <li>Дроп скинов</li>
    </ul>
    <a href="https://t.me/z0rtez" target="_blank" class="premium-buy-btn">Оформить в Telegram</a>
  </div>
</div>

<script>
// Данные составов
const TEAMS = {
  cs2: [
    { title: 'Основной состав', coach: 'mANDEZ', players: [{n:'welxxxoz'},{n:'genn'},{n:'mineboy'},{n:'nocs'},{n:'HEARTLE55'}] },
    { title: 'Young Guard', players: [{n:'revinho'},{n:'YTOM'},{n:'des'},{n:'fR0-sT'},{n:'NeeLz666'}] },
    { title: 'NXT', players: [{n:'doas'},{tba:1},{tba:1},{tba:1},{tba:1}] },
    { title: 'Prince, 2nd Guard, Cadets', soon: 1 }
  ],
  dota2: [{ title: 'Основной состав', players: [{n:'TRACE'},{n:'filler132'},{tba:1},{tba:1},{tba:1}] }],
  brawl: [{ title: 'Основной состав', players: [{tba:1},{tba:1},{tba:1}] }],
  chess: [{ title: 'Основной состав', players: [{n:'jazz', sub:'Семён Батраков'}] }]
};

function showTeam(game, btn) {
  // Переключение кнопок
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  btn.classList.add('active');
  
  // Отрисовка
  let html = '';
  TEAMS[game].forEach(g => {
    if (g.soon) {
      html += `<div class="group"><h3>${g.title}</h3><p class="soon">Составы объявим позже</p></div>`;
      return;
    }
    let coach = g.coach ? `<span>Тренер: ${g.coach}</span>` : '';
    html += `<div class="group"><h3>${g.title}${coach}</h3><ul class="roster">`;
    
    g.players.forEach(p => {
      if (p.tba) {
        html += `<li class="tba"><span class="flag">?</span><span class="nick">TBA</span><span class="sub">Слот открыт</span></li>`;
      } else {
        html += `<li><span class="flag">🇷🇺</span><span class="nick">${p.n}</span>${p.sub ? `<span class="sub">${p.sub}</span>` : ''}</li>`;
      }
    });
    html += `</ul></div>`;
  });
  document.getElementById('roster').innerHTML = html;
}

// Инициализация первого таба
showTeam('cs2', document.querySelector('.tab'));

// Модалки
const authModal = document.getElementById('auth-modal');
const premiumModal = document.getElementById('premium-modal');

document.getElementById('open-auth').onclick = () => authModal.style.display = 'flex';
document.getElementById('close-auth').onclick = () => authModal.style.display = 'none';
document.getElementById('open-premium').onclick = () => premiumModal.style.display = 'flex';
document.getElementById('close-premium').onclick = () => premiumModal.style.display = 'none';

window.onclick = (e) => {
  if (e.target === authModal) authModal.style.display = 'none';
  if (e.target === premiumModal) premiumModal.style.display = 'none';
};

// Supabase
const SUPABASE_URL = 'https://kgqehmbikmojjibgnkmw.supabase.co';
const SUPABASE_ANON_KEY = 'sb_publishable_nuxn0cjhzeC97AnTwjBTJw_800rLSLt';
const supabase = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

document.getElementById('auth-form').onsubmit = async (e) => {
  e.preventDefault();
  const email = document.getElementById('email').value;
  const password = document.getElementById('password').value;
  const btn = document.getElementById('submit-btn');
  const msg = document.getElementById('auth-message');
  
  btn.innerText = 'Загрузка...';
  btn.disabled = true;
  msg.innerText = '';

  let { error } = await supabase.auth.signInWithPassword({ email, password });

  if (error && error.message.includes('Invalid login credentials')) {
    let { error: signUpError } = await supabase.auth.signUp({ email, password });
    if (signUpError) {
      msg.style.color = '#e4002b';
      msg.innerText = 'Ошибка: ' + signUpError.message;
    } else {
      msg.style.color = '#4caf50';
      msg.innerText = 'Аккаунт создан!';
      setTimeout(() => { authModal.style.display = 'none'; }, 1500);
    }
  } else if (error) {
    msg.style.color = '#e4002b';
    msg.innerText = 'Ошибка: ' + error.message;
  } else {
    msg.style.color = '#4caf50';
    msg.innerText = 'Успешный вход!';
    setTimeout(() => { authModal.style.display = 'none'; }, 1500);
  }

  btn.innerText = 'Войти / Зарегистрироваться';
  btn.disabled = false;
};

// Мобильное меню
document.getElementById('burger').onclick = () => {
  document.getElementById('nav').classList.toggle('open');
};
</script>
</body>
</html>
